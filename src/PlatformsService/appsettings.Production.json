{
  "RabbitMQ": {
    "Host": "rabbitmq-cluster-ip-srv",
    "Port": 5672
  },
  "ConnectionStrings": {
    "Default": "Server=pgsql-cluster-ip-srv;Uid=postgres;Password=123456"
  },
  "CommandsService": {
    "RESTful": "http://commands-cluster-ip-srv:8080"
  },
  "Kestrel": {
    "Endpoints": {
      "gRPC": {
        "Protocols": "Http2",
        "Url": "http://platforms-cluster-ip-srv:8888"
      },
      "RESTful": {
        "Protocols": "Http1AndHttp2",
        "Url": "http://platforms-cluster-ip-srv:8080"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq-cluster-ip-srv:5341",
          "apiKey": "none"
        }
      }
    ]
  }
}