{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Seq",
              "Host": "seq-cluster-ip-srv"
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": "none"
        }
      }
    ]
  },
  "CommandsService": "http://localhost:6000",
  "ConnectionStrings": {
    "Default": "DataSource=:memory:"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672
  }
}
